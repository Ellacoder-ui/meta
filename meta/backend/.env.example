# =============================================================================
# TechVault — Laravel 13 Environment Configuration
# =============================================================================
# Copy this file to `.env` and generate an application key:
#   cp .env.example .env
#   php artisan key:generate
#   php artisan migrate --force
# =============================================================================

# -----------------------------------------------------------------------------
# Application
# -----------------------------------------------------------------------------
APP_NAME=TechVault
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_TIMEZONE=UTC
APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
APP_MAINTENANCE_STORE=database

BCRYPT_ROUNDS=12

# -----------------------------------------------------------------------------
# Logging
# -----------------------------------------------------------------------------
LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_DEPRECATIONS_TRACE=false
LOG_LEVEL=debug

# -----------------------------------------------------------------------------
# Database (PostgreSQL)
# -----------------------------------------------------------------------------
# Connection: pgsql (PostgreSQL)
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=techvault
DB_USERNAME=postgres
DB_PASSWORD=

DB_FOREIGN_KEYS=true
DB_CHARSET=utf8
DB_COLLATION=
DB_SSLMODE=prefer

# -----------------------------------------------------------------------------
# Session
# -----------------------------------------------------------------------------
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_EXPIRE_ON_CLOSE=false
SESSION_CONNECTION=
SESSION_TABLE=sessions
SESSION_STORE=
SESSION_LOTTERY=[2,100]
SESSION_COOKIE=
SESSION_PATH=/
SESSION_DOMAIN=
SESSION_SECURE_COOKIE=
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax
SESSION_PARTITIONED_COOKIE=false

# -----------------------------------------------------------------------------
# Cache
# -----------------------------------------------------------------------------
CACHE_STORE=database
CACHE_PREFIX=
CACHE_DATABASE_CONNECTION=
CACHE_DATABASE_TABLE=cache
CACHE_DATABASE_LOCK_CONNECTION=
CACHE_DATABASE_LOCK_TABLE=
CACHE_STORAGE_DISK=
CACHE_STORAGE_PATH=framework/cache/data
CACHE_REDIS_CONNECTION=cache
CACHE_REDIS_LOCK_CONNECTION=default

# -----------------------------------------------------------------------------
# Queue
# -----------------------------------------------------------------------------
QUEUE_CONNECTION=database
QUEUE_FAILED_DRIVER=database-uuids

DB_QUEUE_CONNECTION=
DB_QUEUE_TABLE=jobs
DB_QUEUE=default
DB_QUEUE_RETRY_AFTER=90

REDIS_QUEUE_CONNECTION=default
REDIS_QUEUE=default
REDIS_QUEUE_RETRY_AFTER=90

# -----------------------------------------------------------------------------
# Mail
# -----------------------------------------------------------------------------
MAIL_MAILER=smtp
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# -----------------------------------------------------------------------------
# AWS / S3
# -----------------------------------------------------------------------------
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_URL=
AWS_ENDPOINT=
AWS_USE_PATH_STYLE_ENDPOINT=false

# -----------------------------------------------------------------------------
# Redis
# -----------------------------------------------------------------------------
REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379
REDIS_DB=0

# -----------------------------------------------------------------------------
# Laravel Sanctum (API Token Authentication)
# -----------------------------------------------------------------------------
# For SPA / cookie-based stateful authentication, list the frontend domains
# that should issue stateful Sanctum cookies, comma-separated:
#   SANCTUM_STATEFUL_DOMAINS=localhost:5173,127.0.0.1:5173
#
# This project uses token-based Sanctum authentication (HasApiTokens), so this
# variable is optional unless you enable stateful (cookie) authentication.
SANCTUM_STATEFUL_DOMAINS=localhost:5173,127.0.0.1:5173

# -----------------------------------------------------------------------------
# Vite / Frontend
# -----------------------------------------------------------------------------
VITE_APP_NAME=TechVault

# -----------------------------------------------------------------------------
# CORS (config/cors.php)
# -----------------------------------------------------------------------------
# CORS is configured in config/cors.php and already permits:
#   http://localhost:5173
#   http://127.0.0.1:5173
# No environment variables are required for CORS in this project.
